				tween(Window, { Size = UDim2.fromOffset(Window.AbsoluteSize.X, oldy) }, 0.28)
				closeGlyph.Text = "–"
			end
			open = not open
			task.wait(0.28)
			canopen = true
		end)
		local window_data = {}
		local firstTab = true
